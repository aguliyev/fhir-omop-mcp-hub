#!/bin/sh
# bin/assemble — flatten batches into format dirs with batch-prefixed names, no JSON modification.
# Copies only FHIR Bundle roots (skips Synthea run-metadata JSON).
set -eu
SPIKE_DIR="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SPIKE_DIR/../.." && pwd)"
DATA_ROOT=$(sed -n 's/^DATA_ROOT=//p' "$REPO_ROOT/etc/setup.env" | head -n 1)
case "$DATA_ROOT" in /*) ;; *) DATA_ROOT="$REPO_ROOT/$DATA_ROOT";; esac
WORK="$DATA_ROOT/work/fhir_to_cdm_spike"
python3 - "$WORK" <<'EOF'
import json, glob, os, shutil, sys
work = sys.argv[1]
for fmt in ("r4", "stu3"):
    out = f"{work}/assembled/{fmt}"
    os.makedirs(out, exist_ok=True)
    for old in glob.glob(f"{out}/*.json"):
        os.remove(old)
    n = 0
    for b in ("batch_001", "batch_002"):
        for f in sorted(glob.glob(f"{work}/batches/{b}/{fmt}/*.json")):
            try:
                doc = json.load(open(f))
            except Exception:
                continue
            if doc.get("resourceType") != "Bundle":
                continue
            shutil.copy(f, f"{out}/{b}_{os.path.basename(f)}")
            n += 1
    print(f"{fmt}: {n} files")
EOF
